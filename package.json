    "db:types": "npx --yes supabase@3.0.0 gen types typescript --remote --schema public > src/types/database.ts",
    "db:push": "npx --yes supabase@3.0.0 db push --remote"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
